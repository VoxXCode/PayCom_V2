DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan rewrite jika file atau direktori fisik ada (css, js, src, gambar)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan seluruh request rute ke Front Controller index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

